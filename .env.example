# Exact public base URL you will submit to the grader (no trailing slash, no query/fragment)
BASE_URL=https://your-host.example.com/a2a

# Comma-separated Bearer tokens. Each distinct token = a distinct principal/user.
VALID_TOKENS=change-me-token-1,change-me-token-2

# AI Pipe (https://aipipe.org) — log in there to get a token
AIPIPE_TOKEN=
AIPIPE_BASE_URL=https://aipipe.org/openrouter/v1
AIPIPE_MODEL=google/gemini-2.0-flash-001

DB_PATH=invoice_agent.db
